void touchPin(){
  int touchValue = touchRead(4);
  bool touchNow = touchValue < touchlevel;
  if (touchNow){
    touched = true;
  }
  else{
    touched = false;
  }
  Serial.println(touchValue);
  // Rileva il fronte di discesa (da non toccato a toccato)
  if (touchNow && !touchPrev) {
    ledState = !ledState;
    digitalWrite(23, ledState);
    Serial.println("toch " + ledState);
    if (en)
    {
      en = false;
    }
    else{
      en = true;
    }
  }

  touchPrev = touchNow;
  delay(10);

}
